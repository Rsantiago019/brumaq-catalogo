# Copie este archivo a ".env" y complete los valores.
NODE_ENV=development
PORT=3000

# Clave para firmar las sesiones (mínimo 32 caracteres, aleatoria y secreta).
# Genere una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=54cd6a4e758851838d35663f1c9a49b121f3e30959cc4e74adf971ae88d52f19e41c11ddcd323175fa4816989e99ee15

# Datos del negocio
BUSINESS_NAME=Brumaq
WHATSAPP_NUMBER=5492945000000
INSTAGRAM=brumaqtrevelin
MAP_QUERY=Trevelin, Chubut, Argentina

# Mensaje de WhatsApp. Variables: {producto} {categoria} {url}
WHATSAPP_MESSAGE=Hola, estoy interesado en obtener más información sobre {producto} ({categoria}) que vi en su web.

# Rutas de datos
DB_PATH=./data/catalogo.db
UPLOAD_DIR=./uploads

# Poner en 1 si la app corre detrás de un proxy inverso (Nginx, Cloudflare, etc.)
TRUST_PROXY=0

# Recuperación de contraseña por SMTP (complete con los datos de su proveedor de correo).
# Para Gmail use una contraseña de aplicación; para producción use el dominio HTTPS público.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
PUBLIC_BASE_URL=http://localhost:3000
