{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/handler.js": {
      "includeFiles": "{public/**,views/**,node_modules/sweetalert2/dist/sweetalert2.min.js,node_modules/sweetalert2/dist/sweetalert2.min.css}"
    }
  },
  "headers": [
    {
      "source": "/admin/reset-password.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/api/handler?__path=/p/:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/handler?__path=/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/handler?__path=/robots.txt"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/handler?__path=/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/handler?__path=/admin/:path*"
    },
    {
      "source": "/admin",
      "destination": "/api/handler?__path=/admin"
    }
  ]
}
